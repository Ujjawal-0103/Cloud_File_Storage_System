# ==============================================================
# CloudRage Backend Environment Variables Template
# ==============================================================

# Database Connection (PostgreSQL)
# Local: postgresql://username:password@localhost:5432/cloud_file_storage_db
# Production (Render): External or internal PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/cloud_file_storage_db"

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=3001

# JWT Secrets (Generate strong 64-character random strings for production)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Social Authentication - Google OAuth 2.0
# Google Cloud Console Configuration:
# - Authorized JavaScript origins:
#     http://localhost:3000
#     https://cloudrage.onrender.com
# - Authorized redirect URIs:
#     http://localhost:3001/api/auth/google/callback (Local)
#     https://cloudrage-backend.onrender.com/api/auth/google/callback (Production)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Password Recovery - Resend Email Service
# - For local development: 'CloudRage <onboarding@resend.dev>'
# - For production: Verified domain sender e.g., 'CloudRage <noreply@yourdomain.com>'
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=CloudRage <onboarding@resend.dev>

# Frontend URL (Used for OAuth redirects, email reset links, and CORS)
# Local: http://localhost:3000
# Production: https://cloudrage.onrender.com
FRONTEND_URL=http://localhost:3000